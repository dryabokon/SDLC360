# Copy to .env (git-ignored) and fill in. The skills in .claude/skills read the nearest .env; variables already set
# in the shell win. Never commit .env or paste a token into a chat.

# git-hosting skill (.claude/skills/git-hosting): push, PRs, CI. A fine-grained GitHub token (Contents and Pull
# requests: read and write) for `origin`, github.com/dryabokon/sdlc360.
GH_TOKEN=

# gcp skill and deploy/gcp/site.sh. CLOUDSDK_CONFIG: a gcloud config dir to use instead of your default one.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
# CLOUDSDK_CONFIG=

# The hosted app (deploy/gcp/site.sh). Who may open it, comma separated: domain:example.com, user:someone@example.com
SDLC360_SITE_VIEWERS=
# Git hosts besides GitHub it clones from, and a read-only token (read_repository) for them, kept in Secret Manager
# SDLC360_GIT_HOSTS=gitlab.example.com
SDLC360_GIT_TOKEN=
# The repositories `site.sh seed` lists next to the reference set (space separated URLs), and url=working copy pairs
# whose Claude Code sessions `site.sh sessions` keeps with their latest run
# SDLC360_SEED=https://gitlab.example.com/group/repo
# SDLC360_SEED_SESSIONS=https://gitlab.example.com/group/repo=../repo
