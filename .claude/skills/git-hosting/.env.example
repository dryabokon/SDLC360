# GitHub / GitLab settings for scripts/githost.py. Copy to .env (git-ignored) and fill in.
# githost.py reads .env from the current folder or any parent; variables already set in the shell win.
# Names are the ones the official gh / glab CLIs use, so one .env serves both.

# GitHub: https://github.com/settings/tokens  (classic: repo, workflow; fine-grained: Contents, Pull requests,
# Actions, Issues - read; add write only for `pr-create --apply` / `git push`).
# Public repositories can be read without it, but CI job logs and review threads need it.
GH_TOKEN=

# GitLab: <host>/-/user_settings/personal_access_tokens  (read_api, read_repository; api + write_repository
# only for `pr-create --apply` / `git push`). Public projects can be read without it, except MR threads and job logs.
GITLAB_TOKEN=
# Only needed when there is no git remote to tell the host (self-managed GitLab):
GITLAB_HOST=https://gitlab.com
