# Google Cloud settings for scripts/gcp.py. Copy to .env (git-ignored) and fill in.
# gcp.py reads .env from the current folder or any parent; variables already set in the shell win.
# Authentication is your gcloud sign-in: `gcloud auth login` (no key file needed).

GOOGLE_CLOUD_PROJECT=your-project-id
# Region for Cloud Run services and their images.
GOOGLE_CLOUD_REGION=europe-west1
# Optional: a gcloud account other than the active one.
# GCP_ACCOUNT=you@example.com
